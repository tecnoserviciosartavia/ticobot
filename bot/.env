BOT_API_BASE_URL=http://localhost/api
BOT_API_TOKEN=1|ZvXLWPxfELfWbURQxmYmfFQSrnTvAa13TGmsHhXdb38ea983
BOT_SESSION_PATH=storage/whatsapp-session
BOT_LOG_LEVEL=debug

# Puppeteer/WhatsApp Web
# Si WhatsApp rechaza el QR en headless, se puede intentar BOT_HEADLESS=false (requiere entorno con display/Xvfb).
BOT_HEADLESS=true
BOT_DISABLE_WWEBJS_PATCHES=false

# Diagnóstico: loguea eventos message/message_create con body truncado
BOT_DEBUG_MESSAGES=false

# Reducir actividad del cliente antes de autenticar (puede mejorar vinculación QR)
BOT_ENABLE_MESSAGE_POLLING=true

# Fuerza un User-Agent moderno para evitar rechazos de login por UA antiguo.
# Puedes personalizarlo si lo necesitas.
BOT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36

# Forzar ejecutable de Chromium del sistema (evita usar BROWSER heredado por PM2/VS Code)
BOT_CHROMIUM_PATH=/usr/bin/chromium-browser
